#!/usr/bin/env bash
# Start NeuronScope Studio (if it is not running) and open it in the browser.
# Same as the "NeuronScope" entry install.sh adds to the app menu.
#   ./neuronscope cli …     the terminal client (scripts/ns.py)
#   ./neuronscope godot     the Godot client (connects to a Studio, here or on another machine)
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="$here/venv/bin/python"; [[ -x "$py" ]] || py="$(command -v python3)"
case "${1:-}" in
  cli)   shift; exec "$py" "$here/scripts/ns.py" "$@" ;;          # the terminal client: ./neuronscope cli list-models
  godot) shift                                                     # the Godot client: ./neuronscope godot
         g="${NS_GODOT:-$(command -v godot4 || command -v godot || true)}"
         [[ -n "$g" ]] || { echo "Godot 4 not found: install it, or set NS_GODOT to its binary" >&2; exit 1; }
         exec "$g" --path "$here/viz/godot" "$@" ;;
esac
exec "$py" "$here/scripts/launch.py" "$@"
