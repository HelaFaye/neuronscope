; NeuronScope Godot client.
; Third frontend, same backend. Forward+ for real glow; MultiMesh so the whole
; cell field is one draw call and the GPU stays free for the model.

config_version=5

[application]
config/name="NeuronScope"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]
renderer/rendering_method="forward_plus"
; upscale_mode 0 = Linear (Fast); the default is Bicubic (Slow). Cheaper glow
; matters because the GPU is usually also running the model.
environment/glow/upscale_mode=0
anti_aliasing/quality/msaa_3d=0
